#!/bin/sh
# Checks staged Odin contents and aborts if formatting changes are needed.
# Never modifies working files or the index. Installed by `task hooks:install`;
# the source of truth is
# githooks/, .git/hooks/ is a copy.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.odin$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

odinfmt=${ODINFMT:-$HOME/.local/share/nvim/mason/bin/odinfmt}
if [ ! -x "$odinfmt" ]; then
    echo "pre-commit: odinfmt not found at $odinfmt" >&2
    echo "pre-commit: set ODINFMT or install OLS" >&2
    exit 1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

# Check the index, not the working tree: partially staged files are supported.
printf '%s\n' "$staged" | while IFS= read -r f; do
    git show ":$f" > "$tmpdir/original"
    cp "$tmpdir/original" "$tmpdir/check.odin"
    "$odinfmt" -path:"$tmpdir/check.odin" -w
    if ! cmp -s "$tmpdir/original" "$tmpdir/check.odin"; then
        echo "pre-commit: staged formatting changes needed in $f; commit aborted" >&2
        echo "pre-commit: format the file and stage the intended hunks, then retry" >&2
        exit 1
    fi
done
