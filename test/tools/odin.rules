# universalmutator rules for Odin, applied on top of its universal.rules
# (operators, comparisons, constants). Mutants that do not compile are
# dropped by mutate.pl, so these can be loose.
// ==> SKIP_MUTATING_REST
# Delete a statement: comment out a line that opens or closes no block.
(^\s*)(\S+[^{}]+.*)\n ==> \1/*\2*/\n
# Negate or pin an if condition.
(^\s*)if (.+) \{ ==> \1if !(\2) {
(^\s*)if (.+) \{ ==> \1if false {
(^\s*)if (.+) \{ ==> \1if true {
