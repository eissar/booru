package thumbnail

import "core:bytes"
import "core:encoding/json"
import "core:fmt"
import "core:os"

// we arbitrary cap to 256 (u8 +1 but just use u32)
// u8 * [count] :

Manifest :: struct {
	Count:   u32, // ?limit
	Offsets: map[u32]u32, // id:offset
}

Frame :: struct {
	Manifest:       Manifest,
	ThumbnailBytes: []^bytes.Buffer,
}


main :: proc() {
	d, ok := os.read_entire_file_from_filename(
		"/home/eissar/code/lfs-booru-odin/src/thumbnail/t-metadata.json",
	)
	if !ok {fmt.println("couldn't read"); os.exit(1)}

	j, err := json.parse(d)
	if err != nil {fmt.println("couldn't parse"); os.exit(1)}


	fmt.println(j)
}

